# Copy to .env (git-ignored). docker compose reads it automatically; every value
# below is also the built-in default, so the stack runs without a .env file.
# Outside Docker, export the same variables (or rely on configs/*.yaml).

# ---- Platform -------------------------------------------------------------
# Which config file ml_platform.config.load_config() uses.
ML_CONFIG=configs/distributed.yaml

# ---- Ray ------------------------------------------------------------------
# Inside compose, Dagster connects via the Ray client to the head node.
# From the host:            RAY_ADDRESS=ray://localhost:10001
# Local, no Docker:         leave unset -> ray.init() starts a local cluster
# Job submission (CLI):     ray job submit --address http://localhost:8265 -- ...
RAY_ADDRESS=ray://ray-head:10001
RAY_HEAD_NUM_CPUS=2
RAY_WORKER_NUM_CPUS=2
RAY_GPU_WORKER_NUM_CPUS=4
RAY_GPU_COUNT=1
RAY_SHM_SIZE=2gb
RAY_DASHBOARD_PORT=8265
RAY_CLIENT_PORT=10001
RAY_SERVE_PORT=8000
RAY_METRICS_PORT=8080

# ---- MLflow ---------------------------------------------------------------
# In compose: http://mlflow:5000. From the host: http://localhost:5000.
# Local, no server: sqlite:///mlflow.db (the configs/*.yaml default).
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5000

# ---- Dagster --------------------------------------------------------------
DAGSTER_PORT=3000
